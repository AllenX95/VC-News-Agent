<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="report-date" content="{{ report.report_date }}">
  <meta name="template-version" content="{{ report.template_version }}">
  <title>{{ report.headline }} · {{ report.report_date }}</title>
  <style>
    :root { color-scheme: light; --ink: #172033; --muted: #667085; --line: #d8dee9; --paper: #f7f8fb; --accent: #2656d9; --funding: #9b3c85; }
    * { box-sizing: border-box; }
    body { margin: 0; background: var(--paper); color: var(--ink); font-family: Inter, "Noto Sans SC", "Microsoft YaHei", system-ui, sans-serif; line-height: 1.55; }
    a { color: var(--accent); text-decoration: none; }
    a:hover { text-decoration: underline; }
    .page { width: min(1180px, calc(100% - 32px)); margin: 0 auto; padding: 36px 0 64px; }
    .masthead { display: flex; gap: 24px; justify-content: space-between; align-items: end; border-bottom: 3px solid var(--ink); padding-bottom: 18px; margin-bottom: 24px; }
    h1, h2, h3, p { margin-top: 0; }
    h1 { margin-bottom: 4px; font-size: clamp(28px, 4vw, 46px); letter-spacing: -.03em; }
    h2 { font-size: 26px; margin-bottom: 16px; }
    h3 { font-size: 17px; line-height: 1.35; margin-bottom: 8px; }
    .date, .muted, .meta { color: var(--muted); font-size: 13px; }
    .summary { background: #fff; border: 1px solid var(--line); border-radius: 12px; padding: 18px 20px; margin-bottom: 24px; }
    .stats { display: flex; flex-wrap: wrap; gap: 8px 18px; margin-top: 12px; }
    .stat { color: var(--muted); font-size: 13px; }
    .stat strong { color: var(--ink); font-size: 16px; margin-right: 4px; }
    .warnings { border-left: 4px solid #c28112; background: #fff8e8; padding: 12px 16px; margin: 0 0 24px; }
    .warnings ul { margin: 6px 0 0; padding-left: 20px; }
    .report-section { margin: 34px 0; }
    .section-heading { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; border-bottom: 1px solid var(--line); padding-bottom: 8px; }
    .group { margin: 20px 0 0; }
    .group-title { color: var(--muted); font-size: 14px; font-weight: 700; letter-spacing: .04em; margin-bottom: 10px; }
    .cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(290px, 1fr)); gap: 12px; }
    .report-card { background: #fff; border: 1px solid var(--line); border-radius: 10px; padding: 16px; min-width: 0; }
    .report-card.funding-card { border-top: 3px solid var(--funding); }
    .card-summary { color: #344054; font-size: 14px; margin-bottom: 10px; }
    .card-details { display: flex; flex-wrap: wrap; gap: 4px 12px; margin-top: 10px; }
    .badge { background: #eef2ff; border-radius: 999px; color: #304da2; padding: 2px 8px; font-size: 11px; }
    .sources { border-top: 1px solid #edf0f4; margin-top: 12px; padding-top: 10px; }
    .sources ul { margin: 5px 0 0; padding-left: 18px; font-size: 12px; }
    .empty-state { border: 1px dashed var(--line); border-radius: 10px; color: var(--muted); padding: 22px; text-align: center; background: rgba(255,255,255,.55); }
    footer { border-top: 1px solid var(--line); color: var(--muted); font-size: 12px; margin-top: 46px; padding-top: 14px; }
    @media (max-width: 640px) { .page { width: min(100% - 20px, 1180px); padding-top: 22px; } .masthead { align-items: start; flex-direction: column; gap: 6px; } .cards { grid-template-columns: 1fr; } }
    @media print { body { background: #fff; } .page { width: 100%; padding: 0; } .report-card { break-inside: avoid; } a { color: inherit; text-decoration: none; } }
  </style>
</head>
<body>
  <div class="page" data-report-date="{{ report.report_date }}">
    <header class="masthead">
      <div>
        <h1>{{ report.headline }}</h1>
        <div class="date">{{ report.report_date }} · 模板 {{ report.template_version }}</div>
      </div>
      <div class="muted">结构化日报 / 可追溯版本</div>
    </header>

    <section class="summary" aria-label="日报摘要">
      <p>{{ report.executive_summary }}</p>
      {% if report.stats %}
      <div class="stats">
        <span class="stat"><strong>{{ report.stats.included_items }}</strong>入选条目</span>
        <span class="stat"><strong>{{ report.stats.raw_items }}</strong>原始条目</span>
        <span class="stat"><strong>{{ report.stats.sources_succeeded }}</strong>个来源</span>
        {% if report.stats.failed_sources %}<span class="stat"><strong>{{ report.stats.failed_sources }}</strong>个来源失败</span>{% endif %}
      </div>
      {% endif %}
    </section>

    {% if report.warnings %}
    <aside class="warnings" aria-label="运行警告">
      <strong>运行提示</strong>
      <ul>{% for warning in report.warnings %}<li>{{ warning }}</li>{% endfor %}</ul>
    </aside>
    {% endif %}

    <main>
      {% for section in report.sections %}
      <section class="report-section" id="section-{{ section.key }}" data-report-section="{{ section.key }}">
        {% set section_count = namespace(value=0) %}{% for count_group in section.groups %}{% set section_count.value = section_count.value + (count_group['items'] | length) %}{% endfor %}
        <div class="section-heading"><h2>{{ section.title }}</h2><span class="muted">{{ section_count.value }} 条</span></div>
        {% if section.groups %}
          {% for group in section.groups %}
          <div class="group" data-report-group="{{ group.title }}">
            <div class="group-title">{{ group.title }}</div>
            {% if group['items'] %}
            <div class="cards">
              {% for item in group['items'] %}
              <article class="report-card{% if section.key == 'funding' %} funding-card{% endif %}" data-report-item{% if item.content_id is defined and item.content_id is not none %} data-content-id="{{ item.content_id }}"{% endif %}{% if item.event_id is defined and item.event_id is not none %} data-event-id="{{ item.event_id }}"{% endif %}>
                <h3><a href="{{ item.url }}" target="_blank" rel="noopener noreferrer">{{ item.title }}</a></h3>
                <p class="card-summary">{{ item.summary }}</p>
                {% if item.company_name %}<div class="meta">{{ item.company_name }}{% if item.financing_round %} · {{ item.financing_round }}{% endif %}{% if item.amount %} · {{ item.amount }}{% endif %}</div>{% endif %}
                <div class="card-details">
                  <span class="badge">{{ item.source }}</span>
                  {% if item.published_at %}<span class="meta">{{ item.published_at }}</span>{% endif %}
                  {% for tag in item.tags or [] %}<span class="badge">{{ tag }}</span>{% endfor %}
                </div>
                {% if item.sources %}
                <div class="sources"><span class="meta">合并来源（{{ item.sources | length }}）</span><ul>{% for source in item.sources %}<li><a href="{{ source.url }}" target="_blank" rel="noopener noreferrer">{{ source.source }} · {{ source.title }}</a></li>{% endfor %}</ul></div>
                {% endif %}
              </article>
              {% endfor %}
            </div>
            {% else %}<div class="empty-state">该主题暂无可追溯条目。</div>{% endif %}
          </div>
          {% endfor %}
        {% else %}
          <div class="empty-state">今日暂无{{ section.title }}。</div>
        {% endif %}
      </section>
      {% endfor %}
    </main>

    <footer>生成时间：{{ report.generated_at }} · 数据仅来自 VC News Agent 已入库记录，详情请打开原文核验。</footer>
  </div>
</body>
</html>
